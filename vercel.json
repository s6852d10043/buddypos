{
  "buildCommand": "npx expo export --platform web && node -e \"const fs=require('fs');fs.mkdirSync('dist/admin',{recursive:true});fs.copyFileSync('dist/index.html','dist/admin.html');fs.copyFileSync('dist/index.html','dist/admin/index.html');\"",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
